# Copy this file to .env and fill in real values. Never commit the real .env.

# Your Postgres connection string (from Supabase: Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgres://user:password@host:port/database

# A long random string, used to sign login sessions. Change this to
# something random before deploying anywhere public - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-something-random

# Optional - defaults to 4000 if not set
PORT=4000
